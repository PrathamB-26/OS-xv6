diff --git a/sysfile.c b/sysfile.c
index bfe61b7..da851c9 100644
--- a/sysfile.c
+++ b/sysfile.c
@@ -442,3 +442,40 @@ sys_pipe(void)
   fd[1] = fd1;
   return 0;
 }
+
+int
+sys_lseek(void)
+{
+    int fd, offset, whence, new_offset;
+    struct file *f;
+
+    if (argfd(0, &fd, &f) < 0) {
+        return -1;
+    }
+
+    if (argint(1, &offset) < 0 || argint(2, &whence) < 0) {
+        return -1;
+    }
+
+    if (f->type != FD_INODE) {
+        return -1;
+    }
+
+    if (whence == SEEK_SET) {
+        new_offset = offset;
+    } else if (whence == SEEK_CUR) {
+        new_offset = (int)f->off + offset;
+    } else if (whence == SEEK_END) {
+        new_offset = (int)f->ip->size + offset;
+    } else {
+        return -1;
+    }
+
+    if (new_offset < 0) {
+        return -1;
+    }
+
+    f->off = (uint)new_offset;
+
+    return new_offset;
+}
