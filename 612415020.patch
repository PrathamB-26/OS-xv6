-  if(r)
-    kmem.freelist = r->next;
+  r = kmem.head;
+  if(r) {
+    kmem.head = r->next;
+    if(kmem.head == 0)
+      kmem.tail = 0;
+    r->next = 0;
+  }
   if(kmem.use_lock)
     release(&kmem.lock);
