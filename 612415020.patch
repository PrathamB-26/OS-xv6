@@ -20,7 +20,8 @@ struct run {
 struct {
   struct spinlock lock;
   int use_lock;
-  struct run *freelist;
+  struct run *head;
+  struct run *tail;
 } kmem;
 
 // Initialization happens in two phases.
@@ -33,6 +34,8 @@ kinit1(void *vstart, void *vend)
 {
   initlock(&kmem.lock, "kmem");
   kmem.use_lock = 0;
+  kmem.head = 0;
+  kmem.tail = 0;
   freerange(vstart, vend);
