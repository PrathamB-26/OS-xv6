@@ -69,9 +72,17 @@ kfree(char *v)
 
   if(kmem.use_lock)
     acquire(&kmem.lock);
+
   r = (struct run*)v;
-  r->next = kmem.freelist;
-  kmem.freelist = r;
+  r->next = 0;
+  if(kmem.tail == 0) {
+    kmem.head = r;
+    kmem.tail = r;
+  } else {
+    kmem.tail->next = r;
+    kmem.tail = r;
+  }
+
   if(kmem.use_lock)
     release(&kmem.lock);
 }
@@ -86,9 +97,13 @@ kalloc(void)
 
